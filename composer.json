{
  "name": "instride/opendxp-campaigns",
  "type": "opendxp-bundle",
  "description": "OpenDXP bundle for campaign management, including newsletter and email marketing features.",
  "keywords": [
    "opendxp",
    "opendxp-bundle",
    "newsletter",
    "mailchimp",
    "email-marketing"
  ],
  "homepage": "https://github.com/instride-ch/opendxp-campaigns",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "instride AG",
      "email": "connect@instride.ch",
      "homepage": "https://instride.ch",
      "role": "Digital Agency"
    }
  ],
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
    "open-dxp/admin-bundle": "^1.3",
    "open-dxp/opendxp": "^1.3"
  },
  "require-dev": {
    "codeception/codeception": "^5.0",
    "codeception/module-asserts": "^3.0",
    "codeception/module-symfony": "^3.0",
    "drewm/mailchimp-api": "^2.5",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-symfony": "^2.0"
  },
  "suggest": {
    "drewm/mailchimp-api": "Required for the Mailchimp driver (composer require drewm/mailchimp-api)"
  },
  "autoload": {
    "psr-4": {
      "Instride\\Bundle\\OpenDxpCampaignsBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Instride\\Bundle\\OpenDxpCampaignsBundle\\Tests\\": "tests/"
    }
  },
  "extra": {
    "opendxp": {
      "bundles": [
        "Instride\\Bundle\\OpenDxpCampaignsBundle\\OpenDxpCampaignsBundle"
      ]
    }
  }
}
