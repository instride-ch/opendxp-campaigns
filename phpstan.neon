includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon

parameters:
    level: 8

    paths:
        - src

    scanFiles:
        - vendor/open-dxp/opendxp/stubs/dynamic-constants.php
        # Generated by OpenDXP at runtime, so there is nothing on disk to analyse.
        - stubs/CampaignNewsletterSubscription.php

    ignoreErrors: []
